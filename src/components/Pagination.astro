---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;
const t = useTranslations(Astro.currentLocale);

// Derive base path for page links (handles /posts/, /posts/2/, /zh/posts/2/, /zh/tags/go/2/)
const basePath = page.url.current
  .replace(/\/\d+\/?$/, "")
  .replace(/\/$/, "");

const pageHref = (n: number) => (n === 1 ? `${basePath}/` : `${basePath}/${n}/`);

// Build compact page list with ellipsis when > 7 pages
const total = page.lastPage;
const current = page.currentPage;
const pages: (number | "...")[] = [];
if (total <= 7) {
  for (let i = 1; i <= total; i++) pages.push(i);
} else {
  pages.push(1);
  if (current > 3) pages.push("...");
  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) {
    pages.push(i);
  }
  if (current < total - 2) pages.push("...");
  pages.push(total);
}
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-8 mb-10 flex flex-wrap items-center justify-center gap-2"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="border-border bg-muted/30 text-foreground hover:border-accent/50 hover:text-accent inline-flex items-center gap-1.5 rounded-lg border px-3.5 py-2 text-sm font-medium transition"
          aria-label={t.a11y.goToPreviousPage}
        >
          <IconArrowLeft class="h-4 w-4 rtl:rotate-180" />
          <span>{t.pagination.prev}</span>
        </a>
      ) : (
        <span
          aria-disabled="true"
          class="border-border bg-muted/15 text-muted-foreground inline-flex cursor-not-allowed items-center gap-1.5 rounded-lg border px-3.5 py-2 text-sm font-medium opacity-45 select-none"
        >
          <IconArrowLeft class="h-4 w-4 rtl:rotate-180" />
          <span>{t.pagination.prev}</span>
        </span>
      )}

      <div class="hidden items-center gap-1.5 sm:flex">
        {pages.map(item =>
          item === "..." ? (
            <span class="text-muted-foreground px-2 text-sm select-none">…</span>
          ) : item === current ? (
            <span
              aria-current="page"
              class="bg-accent text-accent-foreground inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-3 text-sm font-semibold shadow-xs"
            >
              {item}
            </span>
          ) : (
            <a
              href={pageHref(item)}
              class="border-border bg-muted/20 text-foreground hover:border-accent/50 hover:text-accent inline-flex h-9 min-w-9 items-center justify-center rounded-lg border px-3 text-sm font-medium transition"
            >
              {item}
            </a>
          )
        )}
      </div>

      <span class="text-muted-foreground px-2 text-sm font-medium sm:hidden">
        {current} / {total}
      </span>

      {page.url.next ? (
        <a
          href={page.url.next}
          class="border-border bg-muted/30 text-foreground hover:border-accent/50 hover:text-accent inline-flex items-center gap-1.5 rounded-lg border px-3.5 py-2 text-sm font-medium transition"
          aria-label={t.a11y.goToNextPage}
        >
          <span>{t.pagination.next}</span>
          <IconArrowRight class="h-4 w-4 rtl:rotate-180" />
        </a>
      ) : (
        <span
          aria-disabled="true"
          class="border-border bg-muted/15 text-muted-foreground inline-flex cursor-not-allowed items-center gap-1.5 rounded-lg border px-3.5 py-2 text-sm font-medium opacity-45 select-none"
        >
          <span>{t.pagination.next}</span>
          <IconArrowRight class="h-4 w-4 rtl:rotate-180" />
        </span>
      )}
    </nav>
  )
}

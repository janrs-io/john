---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags = [], ...props } = data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li class="my-4">
  <article class="group border-border bg-muted/20 hover:border-accent/40 hover:bg-muted/40 rounded-xl border p-5 transition duration-200">
    <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
      <a
        href={postUrl}
        class="text-foreground group-hover:text-accent focus-visible:text-accent text-lg font-semibold leading-snug tracking-tight transition sm:text-xl"
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>
      <div class="shrink-0 text-xs sm:text-sm">
        <Datetime {...props} />
      </div>
    </div>

    <p class="text-muted-foreground mt-2.5 line-clamp-2 text-sm leading-relaxed sm:text-[15px]">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="mt-3.5 flex flex-wrap gap-1.5">
          {tags.slice(0, 4).map(tag => (
            <span class="border-border bg-background/80 text-muted-foreground rounded-md border px-2 py-0.5 text-xs font-medium">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </article>
</li>

---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import johnAbout from "@/assets/images/john-about.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const capabilities = [
  {
    title: "Backend & High-Concurrency Architecture",
    tags: ["Go", "Gin", "gRPC", "pgx/v5", "sqlc", "PostgreSQL"],
    points: [
      "Production backend services in Go and Node.js/TypeScript, including multi-threaded streaming Excel/PDF parsing and type-safe SQL data layers.",
      "High-concurrency consistency engineering: optimistic locking, atomic allocation locks, CAS claim mechanisms, Single-Flight request coalescing, and read-after-write cache invalidation.",
      "Dynamic RBAC, row-level ownership isolation, HMAC-SHA256 edge webhook verification, and single-binary on-premise packaging with embedded frontends.",
    ],
  },
  {
    title: "Infrastructure, Cloud Native & Linux",
    tags: ["Kubernetes HA", "etcd", "Calico", "Istio", "Linux / epoll", "Docker", "Coolify"],
    points: [
      "Bare-metal binary Kubernetes high-availability cluster architecture (control plane HA, etcd, Calico networking, CoreDNS, TLS bootstrap, and Istio service mesh).",
      "Deep Linux systems foundation covering epoll / I/O multiplexing, TCP/network tuning, and containerized self-hosted operations.",
      "Automated build, image optimization, and pre-deploy verification pipelines for zero-downtime delivery.",
    ],
  },
  {
    title: "Modern Full-Stack & Edge Systems",
    tags: ["Next.js", "React", "Astro", "TypeScript", "Tailwind CSS", "Drizzle ORM", "Cloudflare"],
    points: [
      "Full-stack web platforms using Next.js (App Router), React, Vite, Astro, and Drizzle ORM, backed by automated E2E and concurrency test suites.",
      "Edge-native architectures on Cloudflare Pages, Workers, D1, and R2 object storage / CDN.",
      "Multi-language i18n routing, RTL layout support, technical SEO, and AI search optimization (GEO / llms.txt).",
    ],
  },
  {
    title: "Enterprise System Integration",
    tags: ["ERP / CRM", "Webhooks", "IMAP", "OCR Pipelines", "S3 / R2 CDN"],
    points: [
      "End-to-end integration across ERP/CRM platforms with transactional multi-table sync and idempotent API design.",
      "Omnichannel messaging and email (IMAP) ingestion with isolated storage and edge anti-abuse gateways.",
      "High-accuracy local document/PDF rendering and OCR data extraction pipelines.",
    ],
  },
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title}>
    <!-- Top Section: Executive Intro + Framed Photo -->
    <section class="border-border mt-4 grid gap-10 border-b pb-10 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div class="space-y-5">
        <p class="text-accent text-xs font-semibold tracking-widest uppercase">
          10+ Years Experience · Senior Software Engineer &amp; Junior Architect
        </p>

        <p class="text-foreground/95 text-base leading-relaxed sm:text-lg">
          Hi, I&apos;m <strong>John</strong>. Over the past decade, I have designed,
          built, and operated production software ranging from low-level Linux
          and bare-metal Kubernetes clusters to high-concurrency Go backends and
          global edge web platforms.
        </p>

        <p class="text-muted-foreground text-base leading-relaxed">
          I focus on practical, resilient architecture — bridging clean domain
          modeling, strict concurrency and access control, and fast, maintainable
          full-stack delivery without unnecessary complexity.
        </p>

        <div class="grid grid-cols-3 gap-3 pt-2">
          <div class="border-border bg-muted/50 rounded-xl border p-3.5">
            <div class="text-accent text-xl font-bold sm:text-2xl">10+</div>
            <div class="text-muted-foreground mt-0.5 text-xs">Years Engineering</div>
          </div>
          <div class="border-border bg-muted/50 rounded-xl border p-3.5">
            <div class="text-accent text-xl font-bold sm:text-2xl">Go &amp; K8s</div>
            <div class="text-muted-foreground mt-0.5 text-xs">Core Backend &amp; Infra</div>
          </div>
          <div class="border-border bg-muted/50 rounded-xl border p-3.5">
            <div class="text-accent text-xl font-bold sm:text-2xl">Full-Stack</div>
            <div class="text-muted-foreground mt-0.5 text-xs">Next.js · Astro · Edge</div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="/posts/"
            class="bg-accent text-accent-foreground inline-flex items-center rounded-lg px-5 py-2.5 text-sm font-medium shadow-sm transition hover:opacity-90"
          >
            Read Technical Notes
          </a>
          <a
            href="https://github.com/janrs-io"
            target="_blank"
            rel="noopener noreferrer"
            class="border-border bg-muted/60 hover:border-accent/50 inline-flex items-center rounded-lg border px-5 py-2.5 text-sm font-medium transition"
          >
            GitHub (@janrs-io)
          </a>
        </div>
      </div>

      <aside class="mx-auto w-full max-w-sm">
        <div class="border-border bg-muted/40 overflow-hidden rounded-2xl border p-2.5 shadow-sm">
          <Image
            src={johnAbout}
            alt="John — Senior Software Engineer & Junior Architect"
            class="max-h-[460px] w-full rounded-xl object-cover object-top"
          />
          <p class="text-muted-foreground mt-2.5 text-center text-xs tracking-wide">
            John · Senior Software Engineer &amp; Junior Architect
          </p>
        </div>
      </aside>
    </section>

    <!-- Full-Width Core Capabilities 2x2 Grid -->
    <section class="border-border border-b py-10">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold tracking-tight">Core Capabilities</h2>
        <span class="text-muted-foreground text-xs tracking-wider uppercase">
          Architecture &amp; Engineering Depth
        </span>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          capabilities.map(cap => (
            <div class="border-border bg-muted/35 flex flex-col rounded-2xl border p-6 transition hover:border-accent/40">
              <h3 class="text-lg font-semibold tracking-tight">{cap.title}</h3>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {cap.tags.map(tag => (
                  <span class="border-border bg-background text-muted-foreground rounded-md border px-2 py-0.5 text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>
              <ul class="text-foreground/85 mt-4 space-y-2.5 text-sm leading-relaxed">
                {cap.points.map(point => (
                  <li class="flex gap-2.5">
                    <span class="text-accent mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-current" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Bottom Section: Focus & Connect -->
    <section class="grid gap-6 py-10 md:grid-cols-2">
      <div class="border-border bg-muted/25 rounded-2xl border p-6">
        <h2 class="text-lg font-semibold">What I Write About</h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          This site (<code class="text-foreground">john.janrs.com</code>) is where
          I publish practical engineering guides, bare-metal Kubernetes HA series,
          Linux I/O and networking notes, and real-world architecture lessons.
        </p>
      </div>
      <div class="border-border bg-muted/25 rounded-2xl border p-6">
        <h2 class="text-lg font-semibold">Connect &amp; Open Source</h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          Interested in backend architecture, Kubernetes infrastructure, or
          full-stack engineering? Feel free to explore my repositories on{" "}
          <a
            href="https://github.com/janrs-io"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent font-medium underline underline-offset-4"
          >
            github.com/janrs-io
          </a>
          .
        </p>
      </div>
    </section>
  </Main>

  <Footer />
</Layout>
